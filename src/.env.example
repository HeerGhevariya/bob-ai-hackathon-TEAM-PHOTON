# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ─── Application ──────────────────────────────────
APP_PORT=8080
APP_ENV=development

# ─── Supabase (Persistent Database) ──────────────────────────────
# If set, the app uses Supabase for data storage instead of in-memory synthetic data.
# If not set, the app falls back to MockDataSource (zero-config, works out of the box).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── IBM watsonx.ai (OPTIONAL — for enhanced CAPA report narratives) ───
# If not set, the system uses deterministic template-based CAPA generation
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ─── Frontend ────────────────────────────────────
VITE_API_URL=http://localhost:8080
